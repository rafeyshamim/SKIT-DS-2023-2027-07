# Application Settings
PROJECT_NAME="MedVision 3D CT Backend"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkey_change_in_production_environment_with_strong_random_bytes"
ENVIRONMENT="development"
DEBUG=true

# Storage Settings
STORAGE_BACKEND="local"
UPLOAD_DIR="./data/uploads"
PROCESSED_DIR="./data/processed"
MAX_UPLOAD_SIZE_MB=500

# Relational Database (PostgreSQL)
# Uses SQLite as fallback if PostgreSQL is not available in local test mode
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="medvision_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/medvision_db"
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./medvision.db"

# NoSQL Database (MongoDB)
MONGODB_URL="mongodb://root:mongopassword@localhost:27017"
MONGODB_DATABASE="medvision_metadata"

# 3D CNN Inference Settings
MODEL_NAME="MedNet-3D-CNN"
MODEL_VERSION="v1.2.0"
MODEL_WEIGHTS_PATH="./models/weights/mednet_3d_weights.json"
TARGET_VOLUME_SHAPE=[1, 32, 64, 64]
DEVICE="cpu"
BATCH_SIZE=1

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://localhost:5173", "*"]
